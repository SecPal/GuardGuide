{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@secpal/guardguide",
    "version": "0.1.0",
    "description": "GuardGuide standalone instruction management baseline by SecPal.",
    "private": true,
    "type": "module",
    "author": "SecPal",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/SecPal/GuardGuide.git"
    },
    "homepage": "https://github.com/SecPal/GuardGuide#readme",
    "bugs": {
        "url": "https://github.com/SecPal/GuardGuide/issues"
    },
    "keywords": [
        "guardguide",
        "secpal",
        "laravel",
        "inertia",
        "react",
        "shadcn",
        "lingui"
    ],
    "scripts": {
        "lingui:compile": "lingui compile --namespace es",
        "prebuild": "npm run lingui:compile",
        "build": "vite build",
        "prebuild:ssr": "npm run lingui:compile",
        "build:ssr": "vite build && vite build --ssr",
        "predev": "npm run lingui:compile",
        "dev": "vite",
        "format": "prettier --write resources/ README.md docs/decisions/**/*.md",
        "format:check": "prettier --check resources/ README.md docs/decisions/**/*.md",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "npm run test:frontend && npm run build",
        "test:frontend": "vitest run",
        "typecheck": "npm run types:check",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@lingui/cli": "^6.6.0",
        "@lingui/format-po": "^6.6.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.6.1",
        "@laravel/passkeys": "^0.2.0",
        "@lingui/core": "^6.1.0",
        "@lingui/react": "^6.6.0",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-toggle-group": "^1.1.19",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.4",
        "globals": "^17.9.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.1.3",
        "lucide-react": "^1.28.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.8",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@rollup/rollup-win32-x64-msvc": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.1",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    },
    "overrides": {
        "esbuild": ">=0.28.1"
    },
    "engines": {
        "node": ">=22.19.0",
        "npm": ">=10.0.0"
    }
}
